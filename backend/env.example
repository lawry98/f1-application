# ============================================
# F1 Briefing Agent - Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual API keys
# Command: cp env.example .env (Mac/Linux) or copy env.example .env (Windows)

# ============================================
# REQUIRED
# ============================================

# Google AI Studio API Key (REQUIRED — the app exits at startup without it)
# Get your API key from: https://aistudio.google.com/apikey
# Used for: Gemini 3.6 Flash (agent reasoning and synthesis)
# Free tier: yes — see https://aistudio.google.com/rate-limit for your current limits
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# ============================================
# OPTIONAL API KEYS
# ============================================

# Tavily API Key (OPTIONAL — news search is disabled with a warning if unset)
# Get your API key from: https://tavily.com
# Used for: Web search to fetch latest F1 news and storylines
# Free tier: 1000 searches/month
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# OpenWeather API Key (OPTIONAL — weather is disabled with a warning if unset)
# Get your API key from: https://openweathermap.org/api
# Used for: Weather forecasts for race locations
# Free tier: 1000 calls/day
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ============================================
# OPTIONAL - Tuning
# ============================================

# Directory for FastF1's telemetry/schedule cache (default: cache/)
# FASTF1_CACHE_DIR=cache/

# Thread count for the tool fan-out inside the agent's tool executor (default: 4)
# EXECUTOR_MAX_WORKERS=4

# Seconds the running season's standings are reused across requests (default: 300).
# A completed season is cached for the life of the process regardless; 0 disables
# current-season caching.
# STANDINGS_TTL_SECONDS=300

# ── Briefing cost guard ──────────────────────────────────────────────────────
# Every briefing is two Gemini calls. These limits live in the process's memory, so they are
# per worker: run exactly one (uvicorn --workers 1). Behind a proxy, run uvicorn with
# --proxy-headers and FORWARDED_ALLOW_IPS=<the proxy's address> so the per-IP limit sees the
# visitor rather than the proxy. Invalid values warn and fall back to the default.

# Briefings one client IP may start in any rolling hour (default: 5)
# BRIEFING_PER_IP_PER_HOUR=5

# Briefings the whole service may start per UTC day; 0 = no cap (default: 100)
# BRIEFING_DAILY_CAP=100

# Briefings generating at once; a request beyond this is refused as busy, never queued (default: 2)
# BRIEFING_MAX_CONCURRENT=2

# Whole-request deadline in seconds; a normal briefing takes ~25s (default: 90)
# BRIEFING_DEADLINE_SECONDS=90

# Serve Swagger UI (/docs), ReDoc (/redoc) and the OpenAPI schema (/openapi.json).
# Off unless set to 1; any other value warns and stays off. `make dev` sets it.
# Leave it unset in production: the schema maps every route for anyone who asks.
# EXPOSE_API_DOCS=1

# Comma-separated list of origins allowed by CORS
# (default: http://localhost:3000,http://localhost:3001)
# Set this to your deployed frontend URL in production.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# OPTIONAL - LangChain Tracing (for debugging)
# ============================================

# Enable LangSmith tracing to debug agent execution
# Set to 'true' to enable, 'false' or leave empty to disable
LANGCHAIN_TRACING_V2=false

# LangSmith API Key (only needed if tracing is enabled)
# Get your API key from: https://smith.langchain.com
LANGCHAIN_API_KEY=

# LangSmith Project Name (optional)
LANGCHAIN_PROJECT=f1-briefing-agent

# ============================================
# NOTES
# ============================================
#
# 1. Never commit the .env file to version control
# 2. The .env file is already in .gitignore
# 3. API keys should be kept secret and secure
# 4. FastF1 library doesn't require an API key (uses public F1 data)
#
# Costs (as of 2026):
# - Google AI Studio: Free tier. Note that free-tier prompts and responses may be used
#   by Google to improve their products — don't send anything private through it.
# - Tavily: Free tier available, then $1/1000 searches
# - OpenWeather: Free tier available, then $0.0015/call
