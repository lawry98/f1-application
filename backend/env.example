# ============================================
# F1 Briefing Agent - Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual API keys
# Command: cp env.example .env (Mac/Linux) or copy env.example .env (Windows)

# ============================================
# REQUIRED
# ============================================

# Anthropic API Key (REQUIRED — the app exits at startup without it)
# Get your API key from: https://console.anthropic.com
# Used for: Claude Sonnet 4 AI model (agent reasoning and synthesis)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ============================================
# OPTIONAL API KEYS
# ============================================

# Tavily API Key (OPTIONAL — news search is disabled with a warning if unset)
# Get your API key from: https://tavily.com
# Used for: Web search to fetch latest F1 news and storylines
# Free tier: 1000 searches/month
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# OpenWeather API Key (OPTIONAL — weather is disabled with a warning if unset)
# Get your API key from: https://openweathermap.org/api
# Used for: Weather forecasts for race locations
# Free tier: 1000 calls/day
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ============================================
# OPTIONAL - Tuning
# ============================================

# Directory for FastF1's telemetry/schedule cache (default: cache/)
# FASTF1_CACHE_DIR=cache/

# Thread count for the tool fan-out inside the agent's tool executor (default: 4)
# EXECUTOR_MAX_WORKERS=4

# Comma-separated list of origins allowed by CORS
# (default: http://localhost:3000,http://localhost:3001)
# Set this to your deployed frontend URL in production.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# OPTIONAL - LangChain Tracing (for debugging)
# ============================================

# Enable LangSmith tracing to debug agent execution
# Set to 'true' to enable, 'false' or leave empty to disable
LANGCHAIN_TRACING_V2=false

# LangSmith API Key (only needed if tracing is enabled)
# Get your API key from: https://smith.langchain.com
LANGCHAIN_API_KEY=

# LangSmith Project Name (optional)
LANGCHAIN_PROJECT=f1-briefing-agent

# ============================================
# NOTES
# ============================================
#
# 1. Never commit the .env file to version control
# 2. The .env file is already in .gitignore
# 3. API keys should be kept secret and secure
# 4. FastF1 library doesn't require an API key (uses public F1 data)
#
# Costs (as of 2026):
# - Anthropic: Pay per token usage (~$0.003/request typically)
# - Tavily: Free tier available, then $1/1000 searches
# - OpenWeather: Free tier available, then $0.0015/call
